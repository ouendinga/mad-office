# Mad Office Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to the repository

# Database password (required, use a strong random password)
DB_PASSWORD=

# JWT secret for authentication (required, mínimo 32 caracteres: openssl rand -base64 48)
JWT_SECRET=

# Allowed origins for CORS (comma-separated, e.g. http://localhost:8081,https://yourdomain.com)
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000

# Frontend API URLs (leave empty for same-origin via nginx proxy)
API_URL=
WS_URL=

# Token del despertador (el programa que resuelve los turnos con tu suscripción de Claude).
# Genera uno con: openssl rand -hex 32. El mismo valor va en el entorno del despertador.
RUNNER_TOKEN=

# Tope de gasto de IA por persona y día, en dólares (lo corta el servidor).
DAILY_CAP_USD=0.25

# Tras el primer usuario (que es admin), ¿se puede registrar más gente?
ALLOW_REGISTRATION=false

# Reloj de pruebas: 60 = una hora de oficina por minuto real. Vacío/1 = hora real de Madrid.
CLOCK_SPEED=1
# Hora de oficina a la que arranca el reloj de pruebas, p. ej. 2026-11-12T08:58:00+01:00
CLOCK_START=
